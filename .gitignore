# ============================================
# RunningFatiguePrediction - .gitignore
# ============================================

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.log
*.egg-info/
*.egg
.DS_Store
.env
.venv/
.conda/
.ipynb_checkpoints/

# IDEs
.vscode/
.idea/
*.code-workspace

# Data folders to ignore
data/raw/*
data/processed/*
data/enriched/*
data/results/*

# Except specific important files in data/results
!data/results/rpe_file_mapping.csv
data/results/features_dataset_5s_50olap.parquet
data/results/eda_figures/
data/results/eda_figures/*.png
data/results/eda_figures/*.csv

# Documents and temporary files
*.pdf
*.docx
*.zip
notes/
temp/
